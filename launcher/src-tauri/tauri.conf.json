{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhiraLauncher",
  "version": "0.1.0",
  "identifier": "org.flos.phira.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Phira 联机开服器",
        "width": 1040,
        "height": 760,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
